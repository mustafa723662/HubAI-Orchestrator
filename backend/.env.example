GEMINI_API_KEY=your_actual_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_EXPIRE_MINUTES=10080

# Local dev default. In production, set to your deployed frontend's real
# origin(s), comma-separated — e.g. https://your-frontend.netlify.app
ALLOWED_ORIGINS=*

# Optional — defaults to a local SQLite file if unset. In production, point
# at Postgres, e.g. postgresql+psycopg://user:pass@host:5432/dbname
# DATABASE_URL=

# Optional — soft daily cap on /execute calls (shared across all users) to
# protect Gemini's free-tier daily quota. Defaults to 18.
# DAILY_GEMINI_CAP=18
